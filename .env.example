BASE_PATH_FROM_PROJECT="../../../NAS"
BASE_PATH="/NAS/"
BASE_URL="http://localhost:2000"

# The origin the frontend is served from - required for credentialed CORS requests to work
FRONTEND_ORIGIN="http://localhost:3000"

# Set to "false" to disable auth entirely (e.g. quick local testing). Any other value (or unset) requires auth.
AUTH_ENABLED="true"

# bcrypt hash of your login password - generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
AUTH_PASSWORD_HASH=""

# Random secret used to sign session JWTs - generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=""

# Where generated thumbnails are cached on disk (created automatically if missing)
THUMB_CACHE_DIR="./cache/thumbs"

# Only needed if ffmpeg/ffprobe aren't on PATH
FFMPEG_PATH=""
FFPROBE_PATH=""

# Safety net: refuses to recursively delete a folder whose subtree nests more subfolders than this
# below it (0 = only folders with no subfolders at all are deletable; -1 = no limit). Does not
# apply to move - a same-volume move is a single instant directory-entry rename regardless of
# depth, never touches descendants, so it isn't the same kind of irreversible, recursive operation
# delete is.
MAX_DELETE_DEPTH=3